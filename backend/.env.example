# ============ 学迹 StudyFlow 后端配置模板 ============
# ⚠ 本文件是模板：请复制为 .env 后再填真实值，真实密钥绝不写入本文件！
# cp .env.example .env

# 数据库：华为云 RDS (MySQL)。留空则使用本地 SQLite 便于演示
DATABASE_URL=mysql+pymysql://studyflow:password@127.0.0.1:3306/studyflow?charset=utf8mb4

# 缓存：华为云 Redis（可选，留空则不启用）
REDIS_URL=redis://127.0.0.1:6379/0

# 大模型 API（OpenAI 兼容协议：OpenAI / DeepSeek / Qwen 等）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# AI 对话在大模型不可用时降级为规则引擎
LLM_ENABLED=false

# paddleocr 使用本地 CPU 推理；llm 使用兼容接口的视觉模型
OCR_ENGINE=paddleocr

# 可选的服务间访问凭据。网页使用后端登录会话。
API_TOKEN=

# 仅填写实际使用的同源网页地址。公网地址必须使用 HTTPS。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTH_PUBLIC_REGISTRATION=false
